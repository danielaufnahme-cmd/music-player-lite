// Settings page. The rows come from Rust (src/prefs.rs) as one flat model;
// each group is a title followed by rows drawn as one rounded card.
import { ScrollView } from "std-widgets.slint";
import { Theme, Type, Radius } from "theme.slint";
import { Icons } from "icons.slint";
import { Txt, Icon, Button, Field, PageHeader } from "widgets.slint";

// kind: 0 group title, 1 switch, 2 choice, 3 text field, 4 slider, 5 buttons
export struct PrefRow {
    kind: int,
    key: string,
    label: string,
    detail: string,
    on: bool,
    options: [string],
    selected: int,
    value: float,
    text: string,
    // Shown next to the label, e.g. "Applies after restart".
    note: string,
    enabled: bool,
    // Row position inside its card, for the rounded corners and dividers.
    first: bool,
    last: bool,
    // Text fields: show a "Browse" button.
    browse: bool,
}

export global Prefs {
    in-out property <[PrefRow]> rows;
    // Read by other screens.
    in-out property <bool> cover-glow: true;
    in-out property <bool> show-lyrics: true;
    in-out property <bool> karaoke: true;
    // One line under the header: last result or error.
    in-out property <string> status;
    in-out property <bool> status-error;
    // Scroll offset of the page (the screenshot tour sets it).
    in-out property <length> scroll;
    callback toggle(string);
    callback choose(string, int);
    callback text-edited(string, string);
    callback text-accepted(string, string);
    callback browse(string);
    callback slider-moved(string, float);
    callback slider-released(string, float);
}

// Quieter than the shared Switch: a page full of toggles shouldn't be a
// wall of accent colour, so "on" is drawn in the text colour.
component PrefSwitch inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled();
    width: 44px;
    height: 26px;
    border-radius: 13px;
    background: on ? Theme.text.with-alpha(enabled ? 0.88 : 0.35) : Theme.text.with-alpha(0.10);
    border-width: on ? 0 : 1px;
    border-color: Theme.text.with-alpha(0.22);
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        x: on ? parent.width - self.width - 3px : 3px;
        background: on ? Theme.background : Theme.text.with-alpha(enabled ? 0.65 : 0.3);
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => { if (enabled) { root.toggled(); } }
    }
}

component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <bool> enabled: true;
    callback chosen(int);
    height: 34px;
    border-radius: Radius.control;
    border-width: 1px;
    border-color: Theme.outline;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for o[i] in options: Rectangle {
            width: max(56px, t.preferred-width + 24px);
            border-radius: Radius.control - 3px;
            background: i == selected ? Theme.text.with-alpha(Theme.dark ? 0.14 : 0.10) : (ta.has-hover && enabled ? Theme.hover : transparent);
            t := Txt {
                text: o;
                font-size: Type.label-large;
                font-weight: i == selected ? 700 : 500;
                color: !enabled ? Theme.muted.with-alpha(0.5) : (i == selected ? Theme.text : Theme.muted);
            }
            ta := TouchArea {
                mouse-cursor: enabled ? pointer : default;
                clicked => { if (enabled && i != selected) { root.chosen(i); } }
            }
        }
    }
}

component Slider inherits Rectangle {
    in property <float> value; // 0..1
    in property <bool> enabled: true;
    callback moved(float);
    callback released(float);
    private property <float> drag: -1;
    private property <float> shown: drag >= 0 ? drag : clamp(value, 0, 1);
    width: 200px;
    height: 32px;
    Rectangle {
        x: 8px;
        width: parent.width - 16px;
        height: 4px;
        border-radius: 2px;
        background: Theme.text.with-alpha(0.12);
        Rectangle {
            x: 0;
            width: parent.width * shown;
            height: 4px;
            border-radius: 2px;
            background: enabled ? Theme.text.with-alpha(0.72) : Theme.muted.with-alpha(0.4);
        }
    }
    Rectangle {
        x: 8px + (parent.width - 16px) * shown - 7px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: enabled ? Theme.text : Theme.muted;
    }
    ta := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        pointer-event(e) => {
            if (!enabled) { return; }
            if (e.kind == PointerEventKind.down) {
                drag = clamp((self.mouse-x - 8px) / max(1px, self.width - 16px), 0, 1);
                root.moved(drag);
            } else if (e.kind == PointerEventKind.up && drag >= 0) {
                root.released(drag);
                drag = -1;
            }
        }
        moved => {
            if (enabled && self.pressed) {
                drag = clamp((self.mouse-x - 8px) / max(1px, self.width - 16px), 0, 1);
                root.moved(drag);
            }
        }
    }
}

component PrefLine inherits Rectangle {
    in property <PrefRow> item;
    private property <length> r: Radius.panel - 2px;
    background: Theme.surface.with-alpha(Theme.dark ? 0.55 : 0.75);
    border-top-left-radius: item.first ? r : 0;
    border-top-right-radius: item.first ? r : 0;
    border-bottom-left-radius: item.last ? r : 0;
    border-bottom-right-radius: item.last ? r : 0;
    min-height: item.kind == 3 ? 92px : 64px;
    if !item.first: Rectangle {
        x: 20px;
        y: 0;
        width: parent.width - 40px;
        height: 1px;
        background: Theme.outline;
    }
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 20px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Txt {
                    text: item.label;
                    font-size: Type.title-small;
                    font-weight: 600;
                    color: item.enabled ? Theme.text : Theme.muted;
                }
                if item.note != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: note.preferred-width + 14px;
                        height: 20px;
                        border-radius: 10px;
                        background: Theme.tint;
                        note := Txt {
                            text: item.note;
                            font-size: Type.label-small;
                            font-weight: 600;
                            color: Theme.muted;
                        }
                    }
                }
            }
            if item.detail != "": Txt {
                text: item.detail;
                font-size: Type.body-small;
                color: Theme.muted;
                wrap: word-wrap;
            }
            if item.kind == 3: HorizontalLayout {
                padding-top: 8px;
                spacing: 8px;
                Field {
                    horizontal-stretch: 1;
                    text: item.text;
                    hint: "Default folder";
                    font-size: Type.body-medium;
                    pad-v: 8px;
                    enabled: item.enabled;
                    edited(t) => { Prefs.text-edited(item.key, t); }
                    accepted(t) => { Prefs.text-accepted(item.key, t); }
                }
                if item.browse: Button {
                    kind: 2;
                    text: "Browse";
                    icon: Icons.folder-open;
                    has-icon: true;
                    enabled: item.enabled;
                    clicked => { Prefs.browse(item.key); }
                }
            }
        }
        if item.kind == 1: VerticalLayout {
            alignment: center;
            PrefSwitch {
                on: item.on;
                enabled: item.enabled;
                toggled => { Prefs.toggle(item.key); }
            }
        }
        if item.kind == 2: VerticalLayout {
            alignment: center;
            Segmented {
                options: item.options;
                selected: item.selected;
                enabled: item.enabled;
                chosen(i) => { Prefs.choose(item.key, i); }
            }
        }
        if item.kind == 4: HorizontalLayout {
            spacing: 10px;
            alignment: end;
            Slider {
                value: item.value;
                enabled: item.enabled;
                moved(v) => { Prefs.slider-moved(item.key, v); }
                released(v) => { Prefs.slider-released(item.key, v); }
            }
            Txt {
                width: 40px;
                text: item.text;
                horizontal-alignment: right;
                color: Theme.muted;
            }
        }
        if item.kind == 5: HorizontalLayout {
            spacing: 8px;
            alignment: end;
            for o[i] in item.options: VerticalLayout {
                alignment: center;
                Button {
                    kind: i == item.options.length - 1 ? 3 : 1;
                    text: o;
                    enabled: item.enabled;
                    clicked => { Prefs.choose(item.key, i); }
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <length> bottom-pad: 120px;
    ScrollView {
        content-y <=> Prefs.scroll;
        // Keep programmatic scrolling (screenshot tour) inside the content.
        changed content-y => {
            if (self.content-y < min(0px, self.visible-height - col.preferred-height)) {
                self.content-y = min(0px, self.visible-height - col.preferred-height);
            }
        }
        content-height: col.preferred-height;
        col := VerticalLayout {
            alignment: start;
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 40px;
            padding-bottom: bottom-pad;
            PageHeader {
                title: "Settings";
                subtitle: "Changes are saved as you make them";
            }
            if Prefs.status != "": Txt {
                text: Prefs.status;
                color: Prefs.status-error ? Theme.error : Theme.muted;
                font-weight: 600;
                wrap: word-wrap;
            }
            if Prefs.status != "": Rectangle { height: 16px; }
            HorizontalLayout {
                alignment: start;
                VerticalLayout {
                    width: min(820px, root.width - 64px);
                    for row in Prefs.rows: VerticalLayout {
                        if row.kind == 0: VerticalLayout {
                            padding-left: 4px;
                            padding-top: row.first ? 0 : 28px;
                            padding-bottom: 10px;
                            spacing: 2px;
                            Txt {
                                text: row.label;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            if row.detail != "": Txt {
                                text: row.detail;
                                font-size: Type.body-small;
                                color: Theme.muted;
                            }
                        }
                        if row.kind != 0: PrefLine { item: row; }
                    }
                }
            }
        }
    }
}
