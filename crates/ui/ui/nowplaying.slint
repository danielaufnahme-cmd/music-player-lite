// Full-screen player: big cover with a glow over the aurora + layered waves,
// lyrics under the controls, side panel with Up next / Lyrics.
import { Theme, Type, Radius, Covers, TrackItem, LyricLine } from "theme.slint";
import { Icons } from "icons.slint";
import { WaveStack } from "backdrop.slint";
import { Player, Lib, Ui } from "state.slint";
import { Txt, Icon, IconButton, Button, Cover, DownloadIndicator } from "widgets.slint";
import { SeekBar, Controls, QueueRow } from "shell.slint";
import { Prefs } from "settings.slint";

component LyricsStrip inherits VerticalLayout {
    callback open();
    private property <int> i: Player.lyric-line;
    function at(k: int) -> string {
        if (k < 0 || k >= Player.lyrics.length) { return ""; }
        return Player.lyrics[k].text == "" ? "♪" : Player.lyrics[k].text;
    }
    alignment: start;
    if Player.lyrics-state == 0: VerticalLayout {
        padding-top: 10px;
        spacing: 10px;
        HorizontalLayout { alignment: center; Rectangle { width: 260px; height: 14px; border-radius: 3px; background: Theme.tint; } }
        HorizontalLayout { alignment: center; Rectangle { width: 200px; height: 12px; border-radius: 3px; background: Theme.tint; } }
    }
    if Player.lyrics-state == 1: Txt {
        text: "No lyrics for this song";
        font-size: Type.body-small;
        color: Theme.muted;
        horizontal-alignment: center;
    }
    if Player.lyrics-state == 2: HorizontalLayout {
        alignment: center;
        Button {
            kind: 3;
            text: "Show lyrics";
            icon: Icons.lyrics;
            has-icon: true;
            clicked => { root.open(); }
        }
    }
    if Player.lyrics-state == 3: Rectangle {
        height: strip.preferred-height + 12px;
        strip := VerticalLayout {
            spacing: 4px;
            Txt {
                text: i < 0 ? "" : at(i - 1);
                color: Theme.muted.with-alpha(0.7);
                horizontal-alignment: center;
                overflow: elide;
            }
            Txt {
                text: i < 0 ? "♪" : at(i);
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Txt {
                text: at(i + 1);
                color: Theme.muted.with-alpha(0.7);
                horizontal-alignment: center;
                overflow: elide;
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open(); }
        }
    }
}

component LyricsPanel inherits Rectangle {
    private property <int> current: Player.lyrics-state == 3 ? Player.lyric-line : -1;
    private property <duration> user-scrolled;
    if Player.lyrics-state == 0: VerticalLayout {
        padding: 20px;
        spacing: 16px;
        alignment: start;
        for w in [220, 180, 240, 160, 200, 230]: HorizontalLayout {
            alignment: start;
            Rectangle { width: w * 1px; height: 16px; border-radius: 3px; background: Theme.tint; }
        }
    }
    if Player.lyrics-state == 1: VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout { alignment: center; Icon { width: 28px; height: 28px; source: Icons.lyrics-outline; colorize: Theme.muted; } }
        Rectangle { height: 6px; }
        Txt { text: "No lyrics for this song"; font-size: 15px; font-weight: 700; horizontal-alignment: center; }
        Txt { text: "Neither YouTube Music nor LRCLIB has them."; font-size: Type.body-small; color: Theme.muted; horizontal-alignment: center; }
    }
    if Player.lyrics-state >= 2: flick := Flickable {
        content-height: col.preferred-height;
        animate content-y { duration: 450ms; easing: ease-out; }
        col := VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            padding-bottom: 120px;
            alignment: start;
            for l[i] in Player.lyrics: Rectangle {
                private property <bool> active: i == current;
                height: line.preferred-height + 20px;
                changed active => {
                    if (active) {
                        flick.content-y = min(0px, max(flick.height - flick.content-height, -(self.y - flick.height * 0.35)));
                    }
                }
                line := Txt {
                    x: 6px;
                    y: 10px;
                    width: parent.width - 12px;
                    text: l.text == "" ? "♪" : l.text;
                    font-size: Player.lyrics-state == 3 ? Type.title-large : Type.title-medium;
                    font-weight: Player.lyrics-state == 3 ? 800 : 600;
                    wrap: word-wrap;
                    color: Player.lyrics-state != 3 || active ? Theme.text
                        : Theme.text.with-alpha(current >= 0 && i < current ? 0.38 : 0.55);
                    animate color { duration: 300ms; }
                }
                TouchArea {
                    mouse-cursor: l.time-ms >= 0 ? pointer : default;
                    clicked => { if (l.time-ms >= 0) { Player.seek-ms(l.time-ms); } }
                }
            }
            Txt {
                text: (Player.lyrics-state == 2 && Prefs.karaoke ? "Not synced" : "") + (Player.lyrics-state == 2 && Prefs.karaoke && Player.lyrics-source != "" ? " · " : "") + (Player.lyrics-source != "" ? "Lyrics: " + Player.lyrics-source : "");
                font-size: Type.label-small;
                color: Theme.muted;
            }
        }
    }
}

component NowPlayingPanel inherits Rectangle {
    in property <bool> closable;
    callback close();
    background: Theme.surface.with-alpha(Theme.dark ? 0.72 : 0.82);
    border-radius: Radius.panel;
    border-width: 1px;
    border-color: Theme.outline;
    VerticalLayout {
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            padding-top: 8px;
            padding-bottom: 4px;
            spacing: 12px;
            for tab[t] in Prefs.show-lyrics ? ["Up next", "Lyrics"] : ["Up next"]: Rectangle {
                width: tl.preferred-width + 8px;
                height: 36px;
                tl := Txt {
                    text: tab;
                    font-size: 15px;
                    font-weight: Player.np-tab == t ? 700 : 600;
                    color: Player.np-tab == t ? Theme.text : (tt.has-hover ? Theme.text.with-alpha(0.85) : Theme.muted);
                }
                if Player.np-tab == t: Rectangle {
                    x: 4px;
                    width: parent.width - 8px;
                    y: parent.height - 2px;
                    height: 2px;
                    border-radius: 1px;
                    background: Theme.text;
                }
                tt := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Player.np-tab = t; }
                }
            }
            Rectangle { horizontal-stretch: 1; vertical-stretch: 0; height: 1px; }
            if closable: IconButton {
                icon: Icons.close;
                color: Theme.muted;
                clicked => { root.close(); }
            }
        }
        if Player.np-tab == 0 && Player.up-next.length == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            padding: 24px;
            spacing: 4px;
            HorizontalLayout { alignment: center; Icon { width: 28px; height: 28px; source: Icons.queue-music; colorize: Theme.muted; } }
            Rectangle { height: 6px; }
            Txt { text: "Nothing queued"; font-size: 15px; font-weight: 700; horizontal-alignment: center; }
            Txt { text: "Pick “Play next” or “Add to queue” from a song’s ⋯ menu."; font-size: Type.body-small; color: Theme.muted; horizontal-alignment: center; wrap: word-wrap; }
        }
        if Player.np-tab == 0 && Player.up-next.length > 0: VerticalLayout {
            vertical-stretch: 1;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                Txt {
                    horizontal-stretch: 1;
                    text: Player.up-next.length + (Player.up-next.length == 1 ? " song" : " songs");
                    font-size: Type.label-medium;
                    color: Theme.muted;
                }
                Button {
                    kind: 3;
                    text: "Clear";
                    clicked => { Player.clear-up-next(); }
                }
            }
            Flickable {
                vertical-stretch: 1;
                content-height: ql.preferred-height;
                ql := VerticalLayout {
                    alignment: start;
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-bottom: 16px;
                    for t[i] in Player.up-next: QueueRow {
                        track: t;
                        index: i;
                        VerticalLayout {
                            alignment: center;
                            DownloadIndicator {
                                id: t.id;
                                downloaded: t.downloaded;
                                download => { Lib.download("upnext", i); }
                            }
                        }
                    }
                }
            }
        }
        if Player.np-tab == 1 && Prefs.show-lyrics: LyricsPanel { vertical-stretch: 1; }
    }
}

export component NowPlaying inherits Rectangle {
    in property <image> glow;
    in property <image> top;
    in property <image> mid;
    in property <image> low;
    in property <float> f1;
    in property <float> f2;
    private property <bool> wide: self.width >= 1100px;
    private property <bool> panel: Player.np-panel-open;
    private property <length> cover-size: clamp(self.height * 0.40, 200px, 500px);
    background: Theme.background;
    WaveStack {
        width: parent.width;
        height: parent.height;
        top: root.top;
        mid: root.mid;
        low: root.low;
        f1: root.f1;
        f2: root.f2;
    }
    // swallow clicks so the shell below stays inert
    TouchArea { }
    VerticalLayout {
        padding-bottom: 24px;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            IconButton {
                icon: Icons.keyboard-arrow-down;
                icon-size: 32px;
                size: 48px;
                clicked => { Player.now-playing-open = false; }
            }
            Rectangle { horizontal-stretch: 1; vertical-stretch: 0; height: 1px; }
            IconButton {
                icon: panel ? Icons.view-sidebar : Icons.view-sidebar-outline;
                color: panel ? Theme.accent : Theme.text;
                size: 48px;
                clicked => { Player.np-panel-open = !Player.np-panel-open; }
            }
            if Player.has-track: IconButton {
                icon: Icons.playlist-add;
                size: 48px;
                clicked => { Player.add-current-to-playlist(); }
            }
            if !Player.has-track: Rectangle { width: 48px; }
        }
        Rectangle {
            vertical-stretch: 1;
            HorizontalLayout {
                Rectangle {
                    horizontal-stretch: 1;
                    if !Player.has-track: Txt {
                        text: "Nothing is playing";
                        font-size: Type.title-medium;
                    }
                    if Player.has-track: VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: cover-size;
                                height: cover-size;
                                // glow behind the cover
                                if Prefs.cover-glow: Image {
                                    // pre-rendered radial glow (src/visuals.rs): far cheaper to
                                    // repaint behind the moving waves than a radial gradient
                                    width: cover-size + 160px;
                                    height: cover-size + 160px;
                                    source: root.glow;
                                    image-fit: fill;
                                }
                                Cover {
                                    id: Player.id;
                                    size: cover-size;
                                    radius: Radius.hero;
                                }
                            }
                        }
                        Rectangle { height: 32px; }
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                width: min(600px, root.width - 80px - (wide && panel ? 388px : 0));
                                Txt {
                                    text: Player.title;
                                    font-size: 30px;
                                    font-weight: 800;
                                    letter-spacing: -0.9px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    max-height: 76px;
                                }
                                Rectangle { height: 4px; }
                                Txt {
                                    text: Player.artist + (Player.album != "" ? " · " + Player.album : "");
                                    font-size: 15px;
                                    color: Theme.muted.mix(Theme.text, 0.65);
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle { height: 22px; }
                                SeekBar { large: true; }
                                Rectangle { height: 10px; }
                                Controls { large: true; }
                                Rectangle { height: 14px; }
                                if Prefs.show-lyrics: LyricsStrip {
                                    open => {
                                        Player.np-tab = 1;
                                        Player.np-panel-open = true;
                                    }
                                }
                            }
                        }
                    }
                }
                if wide && panel: HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 20px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    NowPlayingPanel { width: 360px; }
                }
            }
            if !wide && panel: NowPlayingPanel {
                x: parent.width - self.width - 12px;
                y: 8px;
                width: min(parent.width * 0.9, 380px);
                height: parent.height - 16px;
                closable: true;
                close => { Player.np-panel-open = false; }
            }
        }
    }
}
